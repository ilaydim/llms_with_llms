# Bu dosyayı .env olarak kopyala ve kendi değerlerini gir.
# NFR-2.3: LLM API anahtarı kod içine gömülmemeli.
# NFR-5.2: Sağlayıcı değiştirmek için sadece bu satırı değiştir, kod değişikliği gerekmez.
#   mock      -> API anahtarı gerekmeden agent'ları/arayüzü test etmek için (varsayılan)
#   anthropic -> Anthropic Claude API
#   openai    -> OpenAI API
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tutor Agent ve Evaluator Agent için kullanılacak model
TUTOR_MODEL=claude-haiku-4-5-20251001
EVALUATOR_MODEL=claude-haiku-4-5-20251001

# Veritabanı (MVP: SQLite, Faz 2: PostgreSQL'e geçilebilir — NFR ile uyumlu)
DATABASE_URL=sqlite:///./llms_with_llms.db

# RAG için kullanılacak local embedding modeli
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_store

# Mastery learning quiz geçme eşiği (FR-6.4, SRS'te TBD olarak işaretli — varsayılan öneri)
QUIZ_PASS_THRESHOLD=0.7

# Konuşma geçmişinde bağlama dahil edilecek maksimum mesaj sayısı (Bölüm 5.4 "Açık nokta")
MAX_CONTEXT_MESSAGES=20
