# Copy this file to .env and fill in your values.
# NFR-2.3: API keys must NOT be hard-coded in source.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# mock      → no API key needed, simulates responses (default for local dev)
# anthropic → Anthropic Claude API
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=

# Model IDs (Haiku is cheapest; switch to claude-sonnet-4-6 for higher quality)
TUTOR_MODEL=claude-haiku-4-5-20251001
EVALUATOR_MODEL=claude-haiku-4-5-20251001

# ── Database ──────────────────────────────────────────────────────────────────
# MVP: SQLite (local file). Phase 2: switch to PostgreSQL by changing this URL.
DATABASE_URL=sqlite:///./llms_with_llms.db

# ── RAG (vector store) ────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_store

# ── Learning settings ─────────────────────────────────────────────────────────
QUIZ_PASS_THRESHOLD=0.7
MAX_CONTEXT_MESSAGES=20

# ── Deployment ────────────────────────────────────────────────────────────────
# Extra origins to allow via CORS (comma-separated). Not needed when frontend
# is served by FastAPI (same origin). Useful for Vercel preview URLs etc.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
